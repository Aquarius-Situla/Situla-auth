# =========================================
# Situla Auth - Environment Variables
# =========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Admin username for the login page
ADMIN_USER=admin

# Admin password (special characters like & # * do NOT need escaping)
# IMPORTANT: Use a strong, random password for production!
ADMIN_PASS=

# JWT secret key — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Cookie domain — your root domain with a leading dot
# e.g. .example.com  (covers auth.example.com, www.example.com, etc.)
COOKIE_DOMAIN=.example.com

# Relying Party ID for WebAuthn/Passkey — hostname of your auth page (no https://)
# e.g. auth.example.com
RP_ID=auth.example.com

# Additional trusted redirect root domains — comma-separated, no wildcards needed
# The parent domain of RP_ID is always trusted automatically:
#   e.g. if RP_ID=auth.example.com, then example.com and *.example.com are trusted by default.
#
# Use this to add extra domains whose root and ALL subdomains should be trusted for redirect.
# Examples:
#   TRUSTED_DOMAINS=a.com                  → trusts a.com and *.a.com
#   TRUSTED_DOMAINS=b.a.com                → trusts b.a.com and *.b.a.com (NOT a.com itself)
#   TRUSTED_DOMAINS=a.com,b.org            → trusts both root domains and all their subdomains
# TRUSTED_DOMAINS=

# ── SMTP Mail (optional) ──────────────────────────────────────────────────────
# When SMTP_HOST is not set, email sending is silently skipped.
# Future features (login alerts, password change notifications, etc.) will use this.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true        # true = TLS (port 465)  |  false = STARTTLS (port 587)
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM="Situla Auth <noreply@example.com>"

# Port the server listens on inside Docker (default: 3000)
# PORT=3000

