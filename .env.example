# =========================================
# Situla Auth - Environment Variables
# =========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Admin username for the login page
ADMIN_USER=your_username

# Admin password (special characters like & # * do NOT need escaping)
ADMIN_PASS=your_secure_password

# JWT secret key — generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret

# Cookie domain — your root domain with a leading dot
# e.g. .example.com  (covers auth.example.com, www.example.com, etc.)
COOKIE_DOMAIN=.example.com

# Relying Party ID for WebAuthn/Passkey — hostname of your auth page (no https://)
# e.g. auth.example.com
RP_ID=auth.example.com

# Port the server listens on inside Docker (default: 3000)
# PORT=3000
