# ==============================================================================
#  Situla Auth - Production Standard .gitignore
#  Crafted for Clean Code & Zero Repository Pollution
# ==============================================================================

# ── 1. Secrets & Sensitive Credentials (严防密钥泄漏) ────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Explicitly track the template
!.env.example

# ── 2. Runtime Data & Databases (本地运行态数据与 SQLite 数据库) ──────────────
data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ── 3. Dependencies & Package Managers (Node 依赖与包管理器缓存) ─────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# ── 4. Dev Tools & Local Utilities (本地与设计辅助工具) ──────────────────────
tools/
svg_produce/
scripts/scratch/
scratch/
tmp/
temp/

# ── 5. Temporary Fixes & Scratch Scripts (临时排错脚本与补丁) ─────────────────
*.py
*.pyc
__pycache__/
/patch_*.js
/fix_*.js
/test_manual_*.js

# ── 6. Test Reports & Code Coverage (测试报告与覆盖率产物) ───────────────────
coverage/
.nyc_output/
*.lcov
.jest/

# ── 7. IDE & Editor Artifacts (编辑器配置与本地缓存) ─────────────────────────
# JetBrains (WebStorm, IDEA)
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Modern Editors (Zed, Fleet, Sublime)
.zed/
.fleet/
*.sublime-project
*.sublime-workspace

# ── 8. OS System Garbage (跨平台操作系统噪音文件) ────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ── 9. Logs & Archive Artifacts (构建与日志产物) ─────────────────────────────
logs/
*.log
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.bak
*.swp
*.swo
